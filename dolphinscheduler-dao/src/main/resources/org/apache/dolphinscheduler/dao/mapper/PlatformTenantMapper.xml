<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.apache.dolphinscheduler.dao.mapper.PlatformTenantMapper">
    <sql id="baseSql">
        id, tenant_code, tenant_name, description, private_admin_token, private_deploy_ip, private_db_type,
        private_db_host, private_db_port, private_db_name, private_db_user, private_db_url, private_deploy_path,
        private_process_check_command, private_nginx_proxy_path, create_time, update_time
    </sql>
    <sql id="baseSqlV2">
        ${alias}.id, ${alias}.tenant_code, ${alias}.tenant_name, ${alias}.description, ${alias}.private_admin_token,
        ${alias}.private_deploy_ip, ${alias}.private_db_type, ${alias}.private_db_host, ${alias}.private_db_port,
        ${alias}.private_db_name, ${alias}.private_db_user, ${alias}.private_db_url, ${alias}.private_deploy_path,
        ${alias}.private_process_check_command, ${alias}.private_nginx_proxy_path, ${alias}.create_time,
        ${alias}.update_time
    </sql>

    <select id="queryByCode" resultType="org.apache.dolphinscheduler.dao.entity.PlatformTenant">
        select
        <include refid="baseSql"/>
        from t_ds_platform_tenant
        where tenant_code = #{tenantCode}
        limit 1
    </select>

    <select id="queryTenantPaging" resultType="org.apache.dolphinscheduler.dao.entity.PlatformTenant">
        select
        <include refid="baseSql"/>
        from t_ds_platform_tenant
        where 1=1
        <if test="searchVal != null and searchVal != ''">
            and (tenant_code like concat('%', #{searchVal}, '%')
            or tenant_name like concat('%', #{searchVal}, '%')
            or description like concat('%', #{searchVal}, '%'))
        </if>
        order by id desc
    </select>

    <select id="queryByUserId" resultType="org.apache.dolphinscheduler.dao.entity.PlatformTenant">
        select
        <include refid="baseSqlV2">
            <property name="alias" value="pt"/>
        </include>
        from t_ds_platform_tenant pt
        join t_ds_platform_tenant_user ptu on pt.id = ptu.platform_tenant_id
        where ptu.user_id = #{userId}
        order by pt.id asc
    </select>
</mapper>
